{
  "mcpServers": {
    "vision": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-vision-server",
        "--api-base-url", "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "--api-path", "/chat/completions",
        "--api-key", "${DASHSCOPE_API_KEY}",
        "--model", "qwen-vl-plus",
        "--timeout-ms", "60000",
        "--max-tokens", "4096"
      ],
      "description": "Qwen VL vision analysis: analyze images, OCR text extraction, template review, image quality scoring"
    }
  }
}
