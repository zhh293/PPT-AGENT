{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dispatch-decision.schema.json",
  "title": "DispatchDecision",
  "type": "object",
  "required": ["job_id", "phase", "worker", "expected_outputs"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "phase": {
      "type": "string",
      "enum": ["document_analysis", "outline_generation", "template_matching", "content_mapping", "visual_generation", "ppt_assembly", "verification"]
    },
    "worker": {"type": "string", "minLength": 1},
    "skill": {"type": "string"},
    "knowledge_base": {"type": "string"},
    "permission_profile": {"type": "string"},
    "context_bundle": {
      "type": "object",
      "properties": {
        "exact_artifacts": {"type": "array", "items": {"type": "string"}},
        "summary_artifacts": {"type": "array", "items": {"type": "string"}},
        "loaded_skills": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "retry_policy": {
      "type": "object",
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "fallback_capability": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
