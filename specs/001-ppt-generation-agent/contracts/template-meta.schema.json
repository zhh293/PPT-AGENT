{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template-meta.schema.json",
  "title": "TemplateProfile",
  "type": "object",
  "required": ["template_id", "style", "slide_count", "slides"],
  "properties": {
    "template_id": {"type": "string", "minLength": 1},
    "domain_tags": {"type": "array", "items": {"type": "string"}},
    "audience_tags": {"type": "array", "items": {"type": "string"}},
    "tone_tags": {"type": "array", "items": {"type": "string"}},
    "color_scheme": {
      "type": "object",
      "properties": {
        "primary": {"type": "string"},
        "secondary": {"type": "string"},
        "accent": {"type": "string"},
        "background": {"type": "string"}
      },
      "additionalProperties": true
    },
    "style": {"type": "string", "minLength": 1},
    "slide_count": {"type": "integer", "minimum": 1},
    "preview_paths": {"type": "array", "items": {"type": "string"}},
    "retrieval_text": {"type": "string"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "layout", "zones"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "layout": {"type": "string", "minLength": 1},
          "visual_density": {"type": "string", "enum": ["low", "medium", "high"], "default": "medium"},
          "supports_generated_background": {"type": "boolean", "default": true},
          "zones": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "position"],
              "properties": {
                "zone_id": {"type": "string"},
                "type": {"type": "string", "enum": ["title", "subtitle", "bullets", "image", "chart", "footer", "decorative"]},
                "position": {
                  "type": "array",
                  "prefixItems": [
                    {"type": "number"},
                    {"type": "number"},
                    {"type": "number"},
                    {"type": "number"}
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                },
                "font_size": {"type": "number"},
                "capacity_hint": {"type": "string"},
                "style_hint": {"type": "string"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
