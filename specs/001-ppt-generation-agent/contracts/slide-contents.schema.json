{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slide-contents.schema.json",
  "title": "SlideContents",
  "type": "object",
  "required": ["template_id", "slides"],
  "properties": {
    "template_id": {"type": "string", "minLength": 1},
    "review_status": {"type": "string", "enum": ["draft", "approved", "needs_review"], "default": "draft"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_index", "layout", "zones"],
        "properties": {
          "slide_index": {"type": "integer", "minimum": 0},
          "layout": {"type": "string", "minLength": 1},
          "review_status": {"type": "string", "enum": ["draft", "edited", "approved", "needs_review"], "default": "draft"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "fallback_flags": {"type": "array", "items": {"type": "string"}},
          "zones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["zone_id", "type", "position", "editable"],
              "properties": {
                "zone_id": {"type": "string", "minLength": 1},
                "type": {"type": "string", "enum": ["title", "subtitle", "bullets", "image", "chart", "footer", "decorative"]},
                "position": {
                  "type": "array",
                  "prefixItems": [
                    {"type": "number", "minimum": 0, "maximum": 1},
                    {"type": "number", "minimum": 0, "maximum": 1},
                    {"type": "number", "minimum": 0, "maximum": 1},
                    {"type": "number", "minimum": 0, "maximum": 1}
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                },
                "content": {
                  "oneOf": [
                    {"type": "string"},
                    {"type": "array", "items": {"type": "string"}},
                    {"type": "null"}
                  ]
                },
                "editable": {"type": "boolean"},
                "source": {"type": "string", "enum": ["user_upload", "generated", "template", "placeholder", "none"], "default": "none"},
                "image_ref": {"type": "string"},
                "image_prompt": {"type": "string"},
                "fit_status": {"type": "string", "enum": ["unknown", "fits", "adjusted", "overflow"], "default": "unknown"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
